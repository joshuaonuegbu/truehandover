# TrueHandover OAuth (BYOS Cloud Drive)
# Copy this file to .env.local for local development.
# In production, set the same keys in your hosting platform's environment settings.

# Google OAuth Client ID (Google Cloud Console)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Dropbox OAuth App Key (Dropbox App Console)
VITE_DROPBOX_OAUTH_CLIENT_ID=

# Microsoft Entra / Azure AD Application (client) ID
VITE_ONEDRIVE_OAUTH_CLIENT_ID=
