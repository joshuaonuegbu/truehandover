# Heartifact Frontend Environment
# Copy this file to .env.local for local development.
# In production, set these in your hosting platform environment settings.

# -----------------------------------------------------------------------------
# Supabase (Frontend/Public)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used by frontend to show Stripe checkout availability (optional).
VITE_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# BYOS OAuth (Planned / Disabled)
# -----------------------------------------------------------------------------
# This repo previously experimented with browser-based OAuth for Drive/Dropbox/OneDrive.
# Production posture: do not store provider OAuth tokens client-side.
# These values are not required unless you re-enable connectors with a secure server-side PKCE flow.
#
# VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_DROPBOX_OAUTH_CLIENT_ID=
# VITE_ONEDRIVE_OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# Platform Storage (R2) - Server-Side Only
# -----------------------------------------------------------------------------
# DO NOT put any R2 secret keys in VITE_ variables.
# Uploads/downloads are performed via Supabase Edge Functions using presigned URLs.

# -----------------------------------------------------------------------------
# Supabase Edge Functions (Server-Side)
# -----------------------------------------------------------------------------
# Restrict which origins can call Edge Functions (comma-separated). Example:
# ALLOWED_ORIGINS=https://app.heartifact.com,https://www.heartifact.com
ALLOWED_ORIGINS=

# Base URL used for Stripe success/cancel redirects (no trailing slash). Example:
# APP_BASE_URL=https://app.heartifact.com
APP_BASE_URL=

# Stripe (Server-Side)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# R2 (Server-Side)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
