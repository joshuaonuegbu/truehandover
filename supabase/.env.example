# Supabase Edge Function Environment Variables
# Copy to supabase/.env.local for local CLI function execution.

# -----------------------------------------------------------------------------
# CORS / App
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call Edge Functions from the browser.
# Example: https://app.truehandover.com,https://www.truehandover.com
ALLOWED_ORIGINS=

# Base URL used for Stripe success/cancel redirects (no trailing slash).
# Example: https://app.truehandover.com
APP_BASE_URL=

# Used to sign client portal links (must be long + random; keep private).
CLIENT_PORTAL_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (email nudges)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
NUDGE_FROM_EMAIL=

# Optional: secret header value for cron invocations of `nudge-sender`
CRON_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare R2 (Platform Bucket)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Supabase (usually injected automatically in hosted functions)
# Keep here for local/debugging clarity
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
